# Folio Backend Environment Variables
# Copy this file to .env and fill in your values

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------

# API Key for authentication (optional, dev mode if unset)
# Generate with: make generate-key
# When unset, API authentication is disabled (dev mode)
FOLIO_API_KEY=

# Frontend API key for Vite build/runtime (optional)
# Must match FOLIO_API_KEY when backend auth is enabled
# Leave empty when FOLIO_API_KEY is unset (dev mode)
VITE_API_KEY=

# Scanner stale windows (seconds)
# Market hours window is Mon-Fri 13:00-22:00 UTC by default.
SCAN_STALE_SECONDS_MARKET_HOURS=900
SCAN_STALE_SECONDS_OFF_HOURS=3600

# Fernet encryption key for sensitive data (Telegram tokens)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# IMPORTANT: Keep this key secret and backed up. Losing this key means losing access to encrypted data.
FERNET_KEY=

# CORS allowed origin for frontend access
# Default: http://localhost:3000 (React dev server)
CORS_ALLOW_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# SQLite database path (relative to container)
# Default: sqlite:///data/radar.db
DATABASE_URL=sqlite:///data/radar.db

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# Directory for application logs
# Default: /app/data/logs
LOG_DIR=/app/data/logs

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# Default: INFO
LOG_LEVEL=INFO

# Log output format: "text" (human-readable, default) or "json" (structured, for ELK / Loki / Grafana)
# JSON schema: timestamp, level, request_id, method, path, status, latency_ms, logger, message
# Example: LOG_FORMAT=json
LOG_FORMAT=text

# ---------------------------------------------------------------------------
# Optional Observability
# ---------------------------------------------------------------------------

# Sentry error tracking (optional)
# Set to your Sentry DSN to enable exception grouping and alerting.
# Install SDK first: uv add "sentry-sdk[fastapi]" in backend/
# Leave empty to disable (default).
SENTRY_DSN=

# Sentry performance sampling rate (0.0 to 1.0, default 0.05 = 5%)
# Higher values give more trace data but consume more Sentry quota.
# SENTRY_TRACES_SAMPLE_RATE=0.05

# ---------------------------------------------------------------------------
# External Services (Optional)
# ---------------------------------------------------------------------------

# Telegram Bot Configuration
# Get your bot token from @BotFather on Telegram
# Note: Custom bot settings are stored in the database via the API,
# not in environment variables
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# J-Quants API (optional, enhances Japanese stock financial data)
# Register at https://jpx-jquants.com for a free refresh token
# When unset, system uses yfinance only (works fine for most use cases)
JQUANTS_API_KEY=

# FinMind API (optional, enhances Taiwan stock financial data)
# Free registration at https://finmindtrade.com to obtain a token
# When unset, system uses yfinance only (works fine for most use cases)
# Circuit breaker: disables for 30 minutes after 3 consecutive failures
FINMIND_API_TOKEN=

# ---------------------------------------------------------------------------
# NISA Eligible Asset Sync
# ---------------------------------------------------------------------------

# Tsumitate NISA eligible fund source (Investment Trusts Association)
# Funds are filtered by the つみたて投資枠の対象 flag in the toushin.or.jp XLSX
# Default uses the same source as Growth NISA; override to use FSA source if needed
ELIGIBLE_TSUMITATE_URL=https://www.toushin.or.jp/static/NISA_growth_productsList/

# Official source page for Growth NISA eligible funds (Investment Trusts Association)
ELIGIBLE_GROWTH_URL=https://www.toushin.or.jp/static/NISA_growth_productsList/

# Periodic sync interval in hours (set to 0 to disable periodic sync)
ELIGIBLE_SYNC_INTERVAL_HOURS=168

# Mutual fund NAV sync interval in hours (set to 0 to disable)
# NAV is published once daily (~20:00 JST), default 24h is appropriate
NAV_SYNC_INTERVAL_HOURS=24

# Toushin-lib CSV download endpoint (Investment Trust Association NAV data)
TOUSHIN_LIB_CSV_URL=https://toushin-lib.fwg.ne.jp/FdsWeb/FDST030000/csv-file-download
# Toushin-lib fund search endpoint (ISIN code lookup for NISA eligible funds)
TOUSHIN_LIB_SEARCH_URL=https://toushin-lib.fwg.ne.jp/FdsWeb/FDST999900/fundDataSearch
